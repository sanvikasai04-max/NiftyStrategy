//@version=5
strategy("EMA 14/34/90 Bounce Strategy", overlay=true, max_labels_count=500, max_lines_count=500, initial_capital=100000, pyramiding=0, process_orders_on_close=false)

// =====================================================
// INPUTS
// =====================================================

emaFastLen = input.int(14, title="Fast EMA", minval=1)
emaMidLen = input.int(34, title="Bounce EMA", minval=1)
emaSlowLen = input.int(90, title="Trend EMA", minval=1)

allowLong = input.bool(true, title="Allow Long")
allowShort = input.bool(true, title="Allow Short")
targetPoints = input.float(50.0, title="Target Points", minval=0.1, step=0.5)

swingLookback = input.int(5, title="Swing SL Lookback", minval=1)
stopLossMode = input.string("Signal Candle", title="Stop Loss Mode", options=["Signal Candle", "Fixed Points", "Swing", "ATR", "EMA 34"])
fixedStopPoints = input.float(10.0, title="Fixed Stop Points", minval=0.1, step=0.5)
useTrailingStop = input.bool(true, title="Use 30-Point Profit Lock")
trailActivatePoints = input.float(30.0, title="Profit Lock Activate Points", minval=0.1, step=0.5)
trailLockPoints = input.float(30.0, title="Profit Lock Points", minval=0.1, step=0.5)
atrStopLen = input.int(14, title="ATR Stop Length", minval=1)
atrStopMult = input.float(1.0, title="ATR Stop Multiplier", minval=0.1, step=0.1)
slBufferPoints = input.float(0.0, title="SL Buffer Points", minval=0.0, step=0.05)

maxDistanceFromFast = input.float(15.0, title="Max Distance From EMA 14", minval=0.1, step=0.5)
bounceBufferPoints = input.float(2.0, title="EMA 34 Bounce Buffer Points", minval=0.0, step=0.5)
requireCandleDirection = input.bool(true, title="Require Candle Direction")

rejectionMode = input.string("Wick", title="Rejection Mode", options=["None", "Wick", "Engulfing", "Either", "Both"])
minWickBodyRatio = input.float(0.8, title="Min Wick/Body Ratio", minval=0.0, step=0.1)
minWickRangePct = input.float(0.25, title="Min Wick/Range %", minval=0.0, maxval=1.0, step=0.05)
useLowRiskRetest = input.bool(true, title="Use Low-Risk Retest Fallback")
maxSignalRiskPoints = input.float(7.0, title="Max Signal Risk Points", minval=0.1, step=0.5)
minEmaBuyRiskPoints = input.float(10.0, title="Min EMA Buy Risk Points", minval=0.0, step=0.5)
minEmaSellRiskPoints = input.float(5.0, title="Min EMA Sell Risk Points", minval=0.0, step=0.5)

useMaChannel = input.bool(false, title="Use EMA High/Low Channel Retest")
useSlopeFilter = input.bool(true, title="Use EMA Slope Filter")
slopeLookback = input.int(5, title="Slope Lookback Bars", minval=1)
minSlopePoints = input.float(0.5, title="Min EMA34 Slope Points/Bar", minval=0.0, step=0.05)
useRibbonFilter = input.bool(true, title="Use EMA Ribbon Width Filter")
ribbonLookback = input.int(20, title="Ribbon Width Average Lookback", minval=1)
minRibbonWidthMult = input.float(0.9, title="Min Ribbon Width Multiplier", minval=0.0, step=0.05)
useVolumeFilter = input.bool(false, title="Use Volume Filter")
volumeLookback = input.int(20, title="Volume Average Lookback", minval=1)
minVolumeMult = input.float(0.9, title="Min Volume Multiplier", minval=0.0, step=0.05)
entryOnRejectionBreak = input.bool(false, title="Require Close Near Rejection Break")
closeBreakRangePct = input.float(0.25, title="Close Break Range %", minval=0.0, maxval=1.0, step=0.05)

useRsiSetup = input.bool(true, title="Show RSI Momentum Candidates")
tradeRsiSetup = input.bool(true, title="Trade RSI Setup")
rsiFastLen = input.int(10, title="RSI Fast Length", minval=1)
rsiTrendLen = input.int(50, title="RSI Trend Length", minval=1)
rsiTrendBuffer = input.float(5.0, title="RSI 50 Trend Buffer", minval=0.0, step=0.1)
rsiBuyMomentumLevel = input.float(60.0, title="RSI Buy Momentum Level", minval=1.0, maxval=99.0, step=0.5)
rsiBuyPullbackLevel = input.float(40.0, title="RSI Buy Pullback Level", minval=1.0, maxval=99.0, step=0.5)
rsiSellMomentumLevel = input.float(40.0, title="RSI Sell Momentum Level", minval=1.0, maxval=99.0, step=0.5)
rsiSellPullbackLevel = input.float(60.0, title="RSI Sell Pullback Level", minval=1.0, maxval=99.0, step=0.5)
rsiRetestBars = input.int(3, title="RSI Retest Bars", minval=1)
rsiBreakoutLookback = input.int(3, title="RSI Breakout Lookback", minval=1)
rsiBreakoutBuffer = input.float(0.0, title="RSI Breakout Buffer Points", minval=0.0, step=0.05)
rsiPriceActionConfirm = input.string("Breakout", title="RSI Price Action Confirmation", options=["None", "Breakout", "Rejection", "Either"])
rsiUseEmaTrendFilter = input.bool(true, title="RSI Use EMA Trend Filter")
rsiTargetPoints = input.float(30.0, title="RSI Target Points", minval=0.1, step=0.5)
maxRsiRiskPoints = input.float(20.0, title="Max RSI Risk Points", minval=0.1, step=0.5)
rsiAvoidDisplacementCandle = input.bool(true, title="RSI Avoid Displacement Candle")
rsiTradeLong = input.bool(false, title="Trade RSI Long")
rsiTradeShort = input.bool(true, title="Trade RSI Short")
rsiMinTradeMinutes = input.int(5, title="RSI Min Trade Timeframe Minutes", minval=1)

useSmcSetup = input.bool(true, title="Show SMC Candidates")
tradeSmcSetup = input.bool(true, title="Trade SMC Setup")
smcSwingLookback = input.int(10, title="SMC Swing Lookback", minval=2)
smcSweepBuffer = input.float(1.0, title="SMC Sweep Buffer Points", minval=0.0, step=0.05)
smcBreakBuffer = input.float(0.5, title="SMC Break Buffer Points", minval=0.0, step=0.05)
smcLevelBuffer = input.float(8.0, title="SMC Level Buffer Points", minval=0.0, step=0.5)
smcZoneBuffer = input.float(1.0, title="SMC Zone Buffer Points", minval=0.0, step=0.05)
smcChochLookback = input.int(10, title="SMC CHOCH Lookback", minval=1)
smcCisdLookback = input.int(3, title="SMC CISD Lookback", minval=1)
smcAmdLookback = input.int(12, title="SMC AMD Lookback", minval=2)
smcAmdMaxRangePoints = input.float(45.0, title="SMC AMD Max Range Points", minval=0.1, step=0.5)
smcTrapLookback = input.int(8, title="SMC Trap Lookback", minval=2)
smcTrapMinSweeps = input.int(3, title="SMC Trap Min Sweeps", minval=1)
smcAvoidTrapZones = input.bool(true, title="SMC Avoid Trap Zones")
smcRequireDisplacement = input.bool(true, title="SMC Require Displacement")
smcDisplacementMult = input.float(0.8, title="SMC Displacement Multiplier", minval=0.0, step=0.1)
smcTargetPoints = input.float(30.0, title="SMC Target Points", minval=0.1, step=0.5)
maxSmcRiskPoints = input.float(20.0, title="Max SMC Risk Points", minval=0.1, step=0.5)
minSmcRiskPoints = input.float(16.0, title="Min SMC Risk Points", minval=0.0, step=0.5)
smcTradeLong = input.bool(false, title="Trade SMC Long")
smcTradeShort = input.bool(true, title="Trade SMC Short")
smcMinTradeMinutes = input.int(5, title="SMC Min Trade Timeframe Minutes", minval=1)
showSmcLevels = input.bool(true, title="Show SMC Levels")

useChopFilter = input.bool(false, title="Avoid EMA Overlap Chop")
chopLookback = input.int(5, title="Chop Lookback Bars", minval=2)
chopMinEmaOverlaps = input.int(3, title="Chop Min EMA Overlaps", minval=2, maxval=3)
maxChopOverlapBars = input.int(2, title="Max Choppy Overlap Bars", minval=0)

useSessionFilter = input.bool(true, title="Use Entry Session")
entryStartHour = input.int(9, title="Entry Start Hour", minval=0, maxval=23)
entryStartMinute = input.int(15, title="Entry Start Minute", minval=0, maxval=59)
entryEndHour = input.int(15, title="Entry End Hour", minval=0, maxval=23)
entryEndMinute = input.int(30, title="Entry End Minute", minval=0, maxval=59)
emaBuyEntryStartHour = input.int(9, title="EMA Buy Entry Start Hour", minval=0, maxval=23)
emaBuyEntryStartMinute = input.int(15, title="EMA Buy Entry Start Minute", minval=0, maxval=59)
emaBuyEntryEndHour = input.int(15, title="EMA Buy Entry End Hour", minval=0, maxval=23)
emaBuyEntryEndMinute = input.int(30, title="EMA Buy Entry End Minute", minval=0, maxval=59)
emaSellEntryStartHour = input.int(9, title="EMA Sell Entry Start Hour", minval=0, maxval=23)
emaSellEntryStartMinute = input.int(15, title="EMA Sell Entry Start Minute", minval=0, maxval=59)
emaSellEntryEndHour = input.int(15, title="EMA Sell Entry End Hour", minval=0, maxval=23)
emaSellEntryEndMinute = input.int(30, title="EMA Sell Entry End Minute", minval=0, maxval=59)
rsiEntryStartHour = input.int(9, title="RSI Entry Start Hour", minval=0, maxval=23)
rsiEntryStartMinute = input.int(15, title="RSI Entry Start Minute", minval=0, maxval=59)
rsiEntryEndHour = input.int(15, title="RSI Entry End Hour", minval=0, maxval=23)
rsiEntryEndMinute = input.int(30, title="RSI Entry End Minute", minval=0, maxval=59)
smcEntryStartHour = input.int(9, title="SMC Entry Start Hour", minval=0, maxval=23)
smcEntryStartMinute = input.int(15, title="SMC Entry Start Minute", minval=0, maxval=59)
smcEntryEndHour = input.int(15, title="SMC Entry End Hour", minval=0, maxval=23)
smcEntryEndMinute = input.int(30, title="SMC Entry End Minute", minval=0, maxval=59)
forceExitHour = input.int(15, title="Force Exit Hour", minval=0, maxval=23)
forceExitMinute = input.int(15, title="Force Exit Minute", minval=0, maxval=59)

showLabels = input.bool(true, title="Show Trade Labels")
labelOffsetAtrLen = input.int(14, title="Label Offset ATR Length", minval=1)
labelOffsetAtrMult = input.float(0.35, title="Label Offset ATR Multiplier", minval=0.0, step=0.05)
labelOffsetMinTicks = input.int(20, title="Label Offset Minimum Ticks", minval=0)

// =====================================================
// CORE
// =====================================================

emaFast = ta.ema(close, emaFastLen)
emaMid = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
emaChannelHigh = ta.ema(high, emaMidLen)
emaChannelLow = ta.ema(low, emaMidLen)
stopAtr = ta.atr(atrStopLen)
labelAtr = ta.atr(labelOffsetAtrLen)
labelOffset = math.max(nz(labelAtr) * labelOffsetAtrMult, syminfo.mintick * labelOffsetMinTicks)

emaMidSlope = (emaMid - emaMid[slopeLookback]) / slopeLookback
emaFastSlope = (emaFast - emaFast[slopeLookback]) / slopeLookback
ribbonWidth = math.abs(emaFast - emaSlow)
ribbonWidthAvg = ta.sma(ribbonWidth, ribbonLookback)
volumeAvg = ta.sma(volume, volumeLookback)
rsiFast = ta.rsi(close, rsiFastLen)
rsiTrend = ta.rsi(close, rsiTrendLen)

candleRange = high - low
body = math.max(math.abs(close - open), syminfo.mintick)
bodyHigh = math.max(open, close)
bodyLow = math.min(open, close)
lowerWick = math.min(open, close) - low
upperWick = high - math.max(open, close)
bullishEngulfing = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bearishEngulfing = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
avgRangeSmc = ta.sma(candleRange, smcAmdLookback)
displacementBuy = close > open + avgRangeSmc * smcDisplacementMult
displacementSell = close < open - avgRangeSmc * smcDisplacementMult

plot(emaFast, color=color.rgb(30, 105, 220), linewidth=2, title="EMA 14")
plot(emaMid, color=color.rgb(210, 140, 40), linewidth=2, title="EMA 34")
plot(emaSlow, color=color.rgb(190, 65, 65), linewidth=2, title="EMA 90")
plot(useMaChannel ? emaChannelHigh : na, color=color.new(color.orange, 55), linewidth=1, title="EMA34 High Channel")
plot(useMaChannel ? emaChannelLow : na, color=color.new(color.orange, 55), linewidth=1, title="EMA34 Low Channel")

inWindow(startHour, startMinute, endHour, endMinute) =>
    not useSessionFilter or ((hour > startHour or (hour == startHour and minute >= startMinute)) and (hour < endHour or (hour == endHour and minute <= endMinute)))

inEntrySession = inWindow(entryStartHour, entryStartMinute, entryEndHour, entryEndMinute)
emaBuyEntrySession = inWindow(emaBuyEntryStartHour, emaBuyEntryStartMinute, emaBuyEntryEndHour, emaBuyEntryEndMinute)
emaSellEntrySession = inWindow(emaSellEntryStartHour, emaSellEntryStartMinute, emaSellEntryEndHour, emaSellEntryEndMinute)
rsiEntrySession = inWindow(rsiEntryStartHour, rsiEntryStartMinute, rsiEntryEndHour, rsiEntryEndMinute)
smcEntrySession = inWindow(smcEntryStartHour, smcEntryStartMinute, smcEntryEndHour, smcEntryEndMinute)
forceExit = hour > forceExitHour or (hour == forceExitHour and minute >= forceExitMinute)

buyStack = emaFast > emaMid and emaMid > emaSlow
sellStack = emaFast < emaMid and emaMid < emaSlow

distanceOK = math.abs(close - emaFast) <= maxDistanceFromFast

emaOverlapCount = (low <= emaFast and high >= emaFast ? 1 : 0) + (low <= emaMid and high >= emaMid ? 1 : 0) + (low <= emaSlow and high >= emaSlow ? 1 : 0)
choppyOverlapBar = emaOverlapCount >= chopMinEmaOverlaps
choppyOverlapCount = math.sum(choppyOverlapBar[1] ? 1 : 0, chopLookback)
chopOK = not useChopFilter or choppyOverlapCount <= maxChopOverlapBars

buyWickOK = lowerWick >= body * minWickBodyRatio and lowerWick >= candleRange * minWickRangePct
sellWickOK = upperWick >= body * minWickBodyRatio and upperWick >= candleRange * minWickRangePct
buyRejectionOK = rejectionMode == "None" ? true : rejectionMode == "Wick" ? buyWickOK : rejectionMode == "Engulfing" ? bullishEngulfing : rejectionMode == "Both" ? buyWickOK and bullishEngulfing : buyWickOK or bullishEngulfing
sellRejectionOK = rejectionMode == "None" ? true : rejectionMode == "Wick" ? sellWickOK : rejectionMode == "Engulfing" ? bearishEngulfing : rejectionMode == "Both" ? sellWickOK and bearishEngulfing : sellWickOK or bearishEngulfing

buyLowRiskRetestOK = useLowRiskRetest and close - low > 0 and close - low <= maxSignalRiskPoints
sellLowRiskRetestOK = useLowRiskRetest and high - close > 0 and high - close <= maxSignalRiskPoints

buySlopeOK = not useSlopeFilter or (emaMidSlope >= minSlopePoints and emaFastSlope > 0)
sellSlopeOK = not useSlopeFilter or (emaMidSlope <= -minSlopePoints and emaFastSlope < 0)
ribbonOK = not useRibbonFilter or (not na(ribbonWidthAvg) and ribbonWidthAvg > 0 and ribbonWidth >= ribbonWidthAvg * minRibbonWidthMult)
volumeOK = not useVolumeFilter or (not na(volumeAvg) and volume >= volumeAvg * minVolumeMult)

buySupportLevel = useMaChannel ? emaChannelLow : emaMid
sellResistanceLevel = useMaChannel ? emaChannelHigh : emaMid
buyRetestOK = low <= buySupportLevel + bounceBufferPoints and close >= buySupportLevel
sellRetestOK = high >= sellResistanceLevel - bounceBufferPoints and close <= sellResistanceLevel
buyBounce = buyRetestOK and close > emaFast
sellBounce = sellRetestOK and close < emaFast

buyCandleOK = not requireCandleDirection or close > open
sellCandleOK = not requireCandleDirection or close < open
buyBreakOK = not entryOnRejectionBreak or close > high - candleRange * closeBreakRangePct
sellBreakOK = not entryOnRejectionBreak or close < low + candleRange * closeBreakRangePct
buyPriceActionOK = buyRejectionOK or buyLowRiskRetestOK
sellPriceActionOK = sellRejectionOK or sellLowRiskRetestOK

emaBuySignal = allowLong and buyStack and buyBounce and buyCandleOK and buyBreakOK and buyPriceActionOK and distanceOK and chopOK and buySlopeOK and ribbonOK and volumeOK
emaSellSignal = allowShort and sellStack and sellBounce and sellCandleOK and sellBreakOK and sellPriceActionOK and distanceOK and chopOK and sellSlopeOK and ribbonOK and volumeOK

rsiBuyTrendOK = rsiTrend >= 50 + rsiTrendBuffer
rsiSellTrendOK = rsiTrend <= 50 - rsiTrendBuffer
rsiBuyMomentum = rsiFast[1] <= rsiBuyMomentumLevel and rsiFast > rsiBuyMomentumLevel
rsiBuyPullback = ta.lowest(rsiFast[1], rsiRetestBars) <= rsiBuyPullbackLevel and rsiFast > rsiFast[1] and rsiFast >= rsiBuyPullbackLevel
rsiSellMomentum = rsiFast[1] >= rsiSellMomentumLevel and rsiFast < rsiSellMomentumLevel
rsiSellPullback = ta.highest(rsiFast[1], rsiRetestBars) >= rsiSellPullbackLevel and rsiFast < rsiFast[1] and rsiFast <= rsiSellPullbackLevel
rsiBreakHigh = ta.highest(high[1], rsiBreakoutLookback)
rsiBreakLow = ta.lowest(low[1], rsiBreakoutLookback)
rsiBuyBreakoutOK = close > rsiBreakHigh + rsiBreakoutBuffer
rsiSellBreakoutOK = close < rsiBreakLow - rsiBreakoutBuffer
rsiBuyRejectionConfirm = close > open and buyRejectionOK
rsiSellRejectionConfirm = close < open and sellRejectionOK
rsiBuyPriceActionOK = rsiPriceActionConfirm == "None" ? true : rsiPriceActionConfirm == "Breakout" ? rsiBuyBreakoutOK : rsiPriceActionConfirm == "Rejection" ? rsiBuyRejectionConfirm : rsiBuyBreakoutOK or rsiBuyRejectionConfirm
rsiSellPriceActionOK = rsiPriceActionConfirm == "None" ? true : rsiPriceActionConfirm == "Breakout" ? rsiSellBreakoutOK : rsiPriceActionConfirm == "Rejection" ? rsiSellRejectionConfirm : rsiSellBreakoutOK or rsiSellRejectionConfirm
rsiBuyEmaTrendOK = not rsiUseEmaTrendFilter or (buyStack and buySlopeOK and ribbonOK)
rsiSellEmaTrendOK = not rsiUseEmaTrendFilter or (sellStack and sellSlopeOK and ribbonOK)
rsiBuyDisplacementOK = not rsiAvoidDisplacementCandle or not displacementBuy
rsiSellDisplacementOK = not rsiAvoidDisplacementCandle or not displacementSell

rsiBuyCandidate = useRsiSetup and allowLong and rsiBuyTrendOK and (rsiBuyMomentum or rsiBuyPullback) and rsiBuyPriceActionOK and rsiBuyEmaTrendOK and rsiBuyDisplacementOK and chopOK
rsiSellCandidate = useRsiSetup and allowShort and rsiSellTrendOK and (rsiSellMomentum or rsiSellPullback) and rsiSellPriceActionOK and rsiSellEmaTrendOK and rsiSellDisplacementOK and chopOK
chartMinutes = timeframe.in_seconds(timeframe.period) / 60.0
rsiTradeTimeframeOK = chartMinutes >= rsiMinTradeMinutes

newDay = ta.change(time("D")) != 0
var float dayHigh = na
var float dayLow = na
dayHigh := newDay ? high : math.max(nz(dayHigh, high), high)
dayLow := newDay ? low : math.min(nz(dayLow, low), low)
prevDayHigh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_off)
prevDayLow = request.security(syminfo.tickerid, "D", low[1], barmerge.gaps_off, barmerge.lookahead_off)
prevHtfHigh = request.security(syminfo.tickerid, "15", high[1], barmerge.gaps_off, barmerge.lookahead_off)
prevHtfLow = request.security(syminfo.tickerid, "15", low[1], barmerge.gaps_off, barmerge.lookahead_off)
smcSwingHigh = ta.highest(high[1], smcSwingLookback)
smcSwingLow = ta.lowest(low[1], smcSwingLookback)

buyLiquiditySweep = (low < smcSwingLow - smcSweepBuffer or low < prevDayLow - smcSweepBuffer or low < prevHtfLow - smcSweepBuffer) and close > math.min(smcSwingLow, math.min(prevDayLow, prevHtfLow))
sellLiquiditySweep = (high > smcSwingHigh + smcSweepBuffer or high > prevDayHigh + smcSweepBuffer or high > prevHtfHigh + smcSweepBuffer) and close < math.max(smcSwingHigh, math.max(prevDayHigh, prevHtfHigh))
turtleSoupBuy = low < prevDayLow - smcSweepBuffer and close > prevDayLow
turtleSoupSell = high > prevDayHigh + smcSweepBuffer and close < prevDayHigh
crtBuy = low < low[1] - smcSweepBuffer and close > high[1]
crtSell = high > high[1] + smcSweepBuffer and close < low[1]
bosBuy = close > smcSwingHigh + smcBreakBuffer
bosSell = close < smcSwingLow - smcBreakBuffer
recentBuySweep = ta.highest(buyLiquiditySweep[1] ? 1 : 0, smcChochLookback) > 0
recentSellSweep = ta.highest(sellLiquiditySweep[1] ? 1 : 0, smcChochLookback) > 0
chochBuy = recentBuySweep and bosBuy
chochSell = recentSellSweep and bosSell
cisdBuy = recentBuySweep and close > ta.highest(bodyHigh[1], smcCisdLookback)
cisdSell = recentSellSweep and close < ta.lowest(bodyLow[1], smcCisdLookback)

bullFvg = low > high[2] + smcZoneBuffer and close > open
bearFvg = high < low[2] - smcZoneBuffer and close < open
var float bullFvgLow = na
var float bullFvgHigh = na
var float bearFvgLow = na
var float bearFvgHigh = na
if bullFvg
    bullFvgLow := high[2]
    bullFvgHigh := low
if bearFvg
    bearFvgLow := high
    bearFvgHigh := low[2]
inBullFvg = not na(bullFvgLow) and low <= bullFvgHigh + smcZoneBuffer and high >= bullFvgLow - smcZoneBuffer
inBearFvg = not na(bearFvgHigh) and high >= bearFvgLow - smcZoneBuffer and low <= bearFvgHigh + smcZoneBuffer
bullIfvg = not na(bearFvgHigh) and close > bearFvgHigh
bearIfvg = not na(bullFvgLow) and close < bullFvgLow

bullOb = close[1] < open[1] and bosBuy
bearOb = close[1] > open[1] and bosSell
var float bullObLow = na
var float bullObHigh = na
var float bearObLow = na
var float bearObHigh = na
if bullOb
    bullObLow := low[1]
    bullObHigh := open[1]
if bearOb
    bearObLow := open[1]
    bearObHigh := high[1]
inBullOb = not na(bullObHigh) and low <= bullObHigh + smcZoneBuffer and high >= bullObLow - smcZoneBuffer
inBearOb = not na(bearObLow) and high >= bearObLow - smcZoneBuffer and low <= bearObHigh + smcZoneBuffer
bullBreaker = not na(bearObHigh) and close > bearObHigh
bearBreaker = not na(bullObLow) and close < bullObLow

amdHigh = ta.highest(high[1], smcAmdLookback)
amdLow = ta.lowest(low[1], smcAmdLookback)
accumulationZone = amdHigh - amdLow <= smcAmdMaxRangePoints
amdBuy = accumulationZone[1] and buyLiquiditySweep and close > amdHigh
amdSell = accumulationZone[1] and sellLiquiditySweep and close < amdLow
sweepCount = math.sum((buyLiquiditySweep[1] or sellLiquiditySweep[1]) ? 1 : 0, smcTrapLookback)
displacementCount = math.sum((displacementBuy[1] or displacementSell[1]) ? 1 : 0, smcTrapLookback)
trapZone = sweepCount >= smcTrapMinSweeps and displacementCount == 0

nearBuyLevel = math.abs(low - smcSwingLow) <= smcLevelBuffer or math.abs(low - prevDayLow) <= smcLevelBuffer or math.abs(low - prevHtfLow) <= smcLevelBuffer
nearSellLevel = math.abs(high - smcSwingHigh) <= smcLevelBuffer or math.abs(high - prevDayHigh) <= smcLevelBuffer or math.abs(high - prevHtfHigh) <= smcLevelBuffer
smcBuyCandidate = useSmcSetup and allowLong and (buyLiquiditySweep or turtleSoupBuy or crtBuy) and (chochBuy or cisdBuy or bosBuy) and (inBullFvg or bullIfvg or inBullOb or bullBreaker or amdBuy or nearBuyLevel) and (not smcRequireDisplacement or displacementBuy) and close > open and (not smcAvoidTrapZones or not trapZone)
smcSellCandidate = useSmcSetup and allowShort and (sellLiquiditySweep or turtleSoupSell or crtSell) and (chochSell or cisdSell or bosSell) and (inBearFvg or bearIfvg or inBearOb or bearBreaker or amdSell or nearSellLevel) and (not smcRequireDisplacement or displacementSell) and close < open and (not smcAvoidTrapZones or not trapZone)
smcTradeTimeframeOK = chartMinutes >= smcMinTradeMinutes

buySignal = emaBuySignal or (tradeRsiSetup and rsiTradeLong and rsiTradeTimeframeOK and rsiBuyCandidate) or (tradeSmcSetup and smcTradeLong and smcTradeTimeframeOK and smcBuyCandidate)
sellSignal = emaSellSignal or (tradeRsiSetup and rsiTradeShort and rsiTradeTimeframeOK and rsiSellCandidate) or (tradeSmcSetup and smcTradeShort and smcTradeTimeframeOK and smcSellCandidate)

buyEntry = buySignal[1] and inEntrySession and strategy.position_size == 0
sellEntry = sellSignal[1] and inEntrySession and strategy.position_size == 0
buyEntrySetup = emaBuySignal[1] ? "EMA" : rsiBuyCandidate[1] and tradeRsiSetup ? "RSI" : "SMC"
sellEntrySetup = emaSellSignal[1] ? "EMA" : rsiSellCandidate[1] and tradeRsiSetup ? "RSI" : "SMC"
buySetupSessionOK = buyEntrySetup == "EMA" ? emaBuyEntrySession : buyEntrySetup == "RSI" ? rsiEntrySession : smcEntrySession
sellSetupSessionOK = sellEntrySetup == "EMA" ? emaSellEntrySession : sellEntrySetup == "RSI" ? rsiEntrySession : smcEntrySession

buySwingSL = ta.lowest(low[1], swingLookback) - slBufferPoints
sellSwingSL = ta.highest(high[1], swingLookback) + slBufferPoints
buySignalSL = low[1] - slBufferPoints
sellSignalSL = high[1] + slBufferPoints
buyFixedSL = open - fixedStopPoints
sellFixedSL = open + fixedStopPoints
buyAtrSL = open - stopAtr * atrStopMult
sellAtrSL = open + stopAtr * atrStopMult
buyEma34SL = emaMid - slBufferPoints
sellEma34SL = emaMid + slBufferPoints

buySelectedSL = stopLossMode == "Fixed Points" ? buyFixedSL : stopLossMode == "Swing" ? buySwingSL : stopLossMode == "ATR" ? buyAtrSL : stopLossMode == "EMA 34" ? buyEma34SL : buySignalSL
sellSelectedSL = stopLossMode == "Fixed Points" ? sellFixedSL : stopLossMode == "Swing" ? sellSwingSL : stopLossMode == "ATR" ? sellAtrSL : stopLossMode == "EMA 34" ? sellEma34SL : sellSignalSL

var float activeSL = na
var float activeTP = na
var float activeRisk = na
var float activeEntry = na
var float bestMove = na

if buyEntry
    risk = open - buySelectedSL
    maxRiskLimit = buyEntrySetup == "RSI" ? maxRsiRiskPoints : buyEntrySetup == "SMC" ? maxSmcRiskPoints : 1000000.0
    minRiskLimit = buyEntrySetup == "EMA" ? minEmaBuyRiskPoints : buyEntrySetup == "SMC" ? minSmcRiskPoints : 0.0
    riskOK = buySetupSessionOK and risk > 0 and risk <= maxRiskLimit and risk >= minRiskLimit
    if riskOK
        activeSL := buySelectedSL
        activeRisk := risk
        activeTP := open + (buyEntrySetup == "RSI" ? rsiTargetPoints : buyEntrySetup == "SMC" ? smcTargetPoints : targetPoints)
        activeEntry := open
        bestMove := 0.0
        strategy.entry("EMA BUY", strategy.long)
        if showLabels
            label.new(bar_index, low - labelOffset, buyEntrySetup + " BUY\nEntry: " + str.tostring(open, format.mintick) + "\nSL (" + stopLossMode + "): " + str.tostring(activeSL, format.mintick) + "\nTarget: " + str.tostring(activeTP, format.mintick) + "\nRisk: " + str.tostring(activeRisk, format.mintick), style=label.style_label_up, color=color.rgb(70, 150, 95), textcolor=color.white, size=size.small)

if sellEntry
    risk = sellSelectedSL - open
    maxRiskLimit = sellEntrySetup == "RSI" ? maxRsiRiskPoints : sellEntrySetup == "SMC" ? maxSmcRiskPoints : 1000000.0
    minRiskLimit = sellEntrySetup == "EMA" ? minEmaSellRiskPoints : sellEntrySetup == "SMC" ? minSmcRiskPoints : 0.0
    riskOK = sellSetupSessionOK and risk > 0 and risk <= maxRiskLimit and risk >= minRiskLimit
    if riskOK
        activeSL := sellSelectedSL
        activeRisk := risk
        activeTP := open - (sellEntrySetup == "RSI" ? rsiTargetPoints : sellEntrySetup == "SMC" ? smcTargetPoints : targetPoints)
        activeEntry := open
        bestMove := 0.0
        strategy.entry("EMA SELL", strategy.short)
        if showLabels
            label.new(bar_index, high + labelOffset, sellEntrySetup + " SELL\nEntry: " + str.tostring(open, format.mintick) + "\nSL (" + stopLossMode + "): " + str.tostring(activeSL, format.mintick) + "\nTarget: " + str.tostring(activeTP, format.mintick) + "\nRisk: " + str.tostring(activeRisk, format.mintick), style=label.style_label_down, color=color.rgb(190, 75, 75), textcolor=color.white, size=size.small)

if strategy.position_size > 0
    bestMove := na(bestMove) ? high - activeEntry : math.max(bestMove, high - activeEntry)
    profitLockActive = useTrailingStop and bestMove >= trailActivatePoints
    activeExitSL = profitLockActive ? math.max(activeSL, activeEntry + trailLockPoints) : activeSL
    strategy.exit("BUY EXIT", "EMA BUY", stop=activeExitSL, limit=activeTP)
    if close <= emaMid
        strategy.close("EMA BUY", comment="Close Below EMA34")

if strategy.position_size < 0
    bestMove := na(bestMove) ? activeEntry - low : math.max(bestMove, activeEntry - low)
    profitLockActive = useTrailingStop and bestMove >= trailActivatePoints
    activeExitSL = profitLockActive ? math.min(activeSL, activeEntry - trailLockPoints) : activeSL
    strategy.exit("SELL EXIT", "EMA SELL", stop=activeExitSL, limit=activeTP)
    if close >= emaMid
        strategy.close("EMA SELL", comment="Close Above EMA34")

if forceExit and strategy.position_size != 0
    strategy.close_all(comment="Day Exit")

plot(strategy.position_size != 0 ? activeSL : na, title="Initial SL", color=color.red, style=plot.style_linebr, linewidth=2)
plot(strategy.position_size != 0 ? activeTP : na, title="Active Target", color=color.green, style=plot.style_linebr, linewidth=2)
plotshape(rsiBuyCandidate, title="RSI BUY Candidate", style=shape.triangleup, location=location.belowbar, color=color.rgb(40, 165, 120), size=size.tiny, text="RSI")
plotshape(rsiSellCandidate, title="RSI SELL Candidate", style=shape.triangledown, location=location.abovebar, color=color.rgb(220, 95, 80), size=size.tiny, text="RSI")
plotshape(smcBuyCandidate, title="SMC BUY Candidate", style=shape.circle, location=location.belowbar, color=color.rgb(35, 190, 160), size=size.tiny, text="SMC")
plotshape(smcSellCandidate, title="SMC SELL Candidate", style=shape.circle, location=location.abovebar, color=color.rgb(225, 120, 60), size=size.tiny, text="SMC")
plotshape(trapZone and useSmcSetup, title="SMC Trap Zone", style=shape.xcross, location=location.top, color=color.rgb(190, 70, 210), size=size.tiny, text="TRAP")
plot(showSmcLevels ? prevDayHigh : na, title="Prev Day High", color=color.new(color.red, 35), linewidth=1)
plot(showSmcLevels ? prevDayLow : na, title="Prev Day Low", color=color.new(color.green, 35), linewidth=1)
plot(showSmcLevels ? prevHtfHigh : na, title="Prev HTF High", color=color.new(color.red, 70), linewidth=1)
plot(showSmcLevels ? prevHtfLow : na, title="Prev HTF Low", color=color.new(color.green, 70), linewidth=1)

alertcondition(buyEntry, title="EMA 14/34/90 BUY ALERT", message="EMA34 dynamic support retest with bullish rejection and trend-quality filters")
alertcondition(sellEntry, title="EMA 14/34/90 SELL ALERT", message="EMA34 dynamic resistance retest with bearish rejection and trend-quality filters")
alertcondition(rsiBuyCandidate, title="RSI BUY CANDIDATE ALERT", message="RSI50 bullish bias with RSI10 momentum or pullback confirmation")
alertcondition(rsiSellCandidate, title="RSI SELL CANDIDATE ALERT", message="RSI50 bearish bias with RSI10 momentum or pullback confirmation")
alertcondition(smcBuyCandidate, title="SMC BUY CANDIDATE ALERT", message="SMC buy: liquidity sweep with CHOCH/CISD and FVG/OB/level confirmation")
alertcondition(smcSellCandidate, title="SMC SELL CANDIDATE ALERT", message="SMC sell: liquidity sweep with CHOCH/CISD and FVG/OB/level confirmation")
